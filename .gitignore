# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
dist/
build/
*.egg-info/

# Environment files (keep .env.example)
.env
.env.local
.env.*.local
# Backups and in-flight writes from scripts/set-integration-env.sh and the
# deploy scripts. These hold the same production secrets as .env itself.
.env.bak.*
.env.tmp.*

# TLS material. The Hetzner runbook has operators drop the Cloudflare origin
# certificate and its private key into ./certs on the host; without this,
# nothing stops `git add -A` from committing the key.
certs/
*.pem
*.key

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
nul

# Logs
*.log
logs/

# Docker volumes (optional, uncomment if needed)
# postgres_data/
# redis_data/

# Test coverage
coverage/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
.cache/

# ML models and training data (generated)
backend/models/
backend/ml_service/
*.pkl
sample_training_data.csv

# Local session notes
SESSION-MEMO-*.md

# Celery
celerybeat-schedule
celerybeat-schedule.*

# Backup files
*.bak

# Vite cache
.vite/

# Claude Code
CLAUDE.local.md
.claude/state/
.claude/settings.local.json
.claude/session_memory.md

