# =============================================================================
# Stratum AI - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=production
APP_NAME=Stratum AI Beta
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Security Keys (GENERATE UNIQUE VALUES!)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_32_char_secret
JWT_SECRET_KEY=CHANGE_ME_generate_32_char_jwt_secret
PII_ENCRYPTION_KEY=CHANGE_ME_generate_32_char_encryption_key
METRICS_API_KEY=CHANGE_ME_generate_metrics_scrape_key
# Empty disables /docs in production. Set to expose Swagger behind ?api_key=.
DOCS_API_KEY=

# -----------------------------------------------------------------------------
# Database (DigitalOcean Managed PostgreSQL)
# Get connection details from DigitalOcean Database dashboard
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://doadmin:PASSWORD@db-host-xxx.ondigitalocean.com:25060/stratum_ai?sslmode=require
DATABASE_URL_SYNC=postgresql://doadmin:PASSWORD@db-host-xxx.ondigitalocean.com:25060/stratum_ai?sslmode=require

# When the stack runs its own Postgres (docker-compose.hetzner.yml, which needs
# the pgvector+AGE image from backend/Dockerfile.postgres), these three are what
# initialise it and what the backup and backup-verify containers authenticate
# with. Compose declares the first two as ${VAR:?...}, so leaving them empty
# stops `docker compose` at interpolation instead of starting a stack whose
# database and backups cannot come up. DATABASE_URL above must then point at
# the `db` service rather than an external host.
POSTGRES_USER=stratum
POSTGRES_PASSWORD=
POSTGRES_DB=stratum_ai

# -----------------------------------------------------------------------------
# Redis (Local on Droplet - configured via Docker Compose)
# These are overridden in docker-compose.beta.yml but kept for reference
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# CORS & URLs
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://beta.stratum-ai.com
FRONTEND_URL=https://beta.stratum-ai.com
API_URL=https://beta.stratum-ai.com/api
VITE_API_BASE_URL=https://beta.stratum-ai.com

# -----------------------------------------------------------------------------
# Email (SendGrid recommended for beta)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_sendgrid_api_key
EMAIL_FROM_ADDRESS=noreply@stratum-ai.com
EMAIL_FROM_NAME=Stratum AI

# -----------------------------------------------------------------------------
# ML & Data Settings
# -----------------------------------------------------------------------------
ML_PROVIDER=local
ML_MODELS_PATH=/app/ml_service/models
USE_MOCK_AD_DATA=false
MARKET_INTEL_PROVIDER=mock

# -----------------------------------------------------------------------------
# Feature Flags (Beta Features)
# -----------------------------------------------------------------------------
SUBSCRIPTION_TIER=professional
FEATURE_FLAG_COMPETITOR_INTEL=true
FEATURE_FLAG_WHATIF_SIMULATOR=true
FEATURE_FLAG_AUTOMATION_RULES=true
FEATURE_FLAG_CDP_AUDIENCE_SYNC=true

# -----------------------------------------------------------------------------
# Slack Notifications (Optional)
# Create webhook at: https://api.slack.com/messaging/webhooks
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#stratum-alerts

# -----------------------------------------------------------------------------
# Sentry Error Tracking (Optional but Recommended)
# Create project at: https://sentry.io
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Ad Platform OAuth (Configure when needed)
# -----------------------------------------------------------------------------
# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta/Facebook
META_APP_ID=
META_APP_SECRET=

# TikTok
# NOTE: the field is TIKTOK_SECRET, not TIKTOK_APP_SECRET. Settings uses
# extra="ignore", so the wrong name is dropped silently at load.
TIKTOK_APP_ID=
TIKTOK_SECRET=

# Snapchat
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# CRM Integrations (Configure when needed)
# -----------------------------------------------------------------------------
# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Pipedrive. The callback registered in the Pipedrive Developer Hub must match
# the redirect_uri sent to POST /api/v1/integrations/pipedrive/connect exactly.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Off-host backups (Cloudflare R2) — REQUIRED on the Hetzner stack
# -----------------------------------------------------------------------------
# docker-compose.hetzner.yml declares these with ${VAR:?...}, so an empty value
# fails `docker compose` at interpolation rather than starting a stack whose
# backups quietly do nothing.
#
# The token needs Object Read & Write on this bucket only. R2_ENDPOINT is the
# S3 API endpoint from the Cloudflare dashboard, not the public bucket URL.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=stratum-backups

# Dump cadence and how long objects are kept. 21600 = 6 hours.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=30

# Restore verification (scripts/backup/verify-restore.sh). 604800 = weekly.
# Each run restores the newest dump into a throwaway database on the same
# server, asserts against it, and drops it — so it needs room for a second
# copy of the data while it runs.
VERIFY_INTERVAL_SECONDS=604800
# Fail verification if the restored database has fewer tenants than this. Left
# at 0 until there is real data: a threshold that cannot fail teaches nothing,
# but one set above the current count fails every run and gets ignored.
VERIFY_MIN_TENANTS=0
