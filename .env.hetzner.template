# =============================================================================
# Stratum AI - Hetzner + Cloudflare environment
# =============================================================================
# Copy to .env on the Hetzner host and fill in. Never commit the result.
#
#   cp .env.hetzner.template .env && chmod 600 .env
#
# Generate secrets with:  openssl rand -base64 48
# =============================================================================

# --- Domain -----------------------------------------------------------------
# app.stratumai.app is Cloudflare Pages; api.stratumai.app is this host.
FRONTEND_URL=https://app.stratumai.app
OAUTH_REDIRECT_BASE_URL=https://api.stratumai.app
CORS_ORIGINS=https://app.stratumai.app,https://stratumai.app

# --- Database ---------------------------------------------------------------
POSTGRES_USER=stratum
POSTGRES_PASSWORD=
POSTGRES_DB=stratum_ai

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=

# --- Application secrets ----------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=

# PII_ENCRYPTION_KEY derives the Fernet keys for user PII and platform
# credentials. Losing it makes every encrypted column unreadable; rotating it
# without a re-encryption pass has the same effect. Back it up somewhere that
# is NOT this host and NOT the R2 bucket the database backups go to — a single
# compromise should not yield both the ciphertext and the key.
PII_ENCRYPTION_KEY=

# --- Cloudflare R2 (off-host database backups) ------------------------------
# Create an R2 bucket with EU jurisdiction so backups stay in the same data
# boundary as the Falkenstein host, then an API token scoped to Object
# Read & Write on that bucket alone.
# Endpoint format: https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stratum-backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=30

# --- Observability ----------------------------------------------------------
SENTRY_DSN=

# --- Stripe -----------------------------------------------------------------
# stripe_webhook_secret is required: the webhook handler fails closed without
# it rather than skipping signature verification, so an unset value means
# Stripe events are rejected, not trusted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Ad platform OAuth ------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
